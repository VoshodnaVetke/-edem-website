{
  "name": "edem-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @edem/ui && npm run build -w @edem/catalog",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run dev -w @edem/catalog",
    "test:browser": "playwright test",
    "format:check": "prettier --check packages apps tests scripts *.json *.ts .github/workflows",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "check:css": "node scripts/check-css.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.32",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
