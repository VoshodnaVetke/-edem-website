{
  "name": "@edem/ui",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/check-css.mjs && tsup && node scripts/styles.mjs",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "roughjs": "4.6.6",
    "three": "0.180.0",
    "@fontsource-variable/onest": "^5.2.8",
    "@fontsource-variable/tektur": "^5.2.8",
    "@fontsource/anonymous-pro": "^5.2.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "esbuild": "^0.25.12",
    "@types/three": "^0.180.0"
  },
  "description": "React-компоненты дизайн-системы ЭДЕМ",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoshodnaVetke/-edem-website.git",
    "directory": "packages/ui"
  }
}
